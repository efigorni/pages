{#- The visual aid (D28–D30), built from lesson.yaml by scripts/build.py. Horizontal slides only, so slide N = page N of the PDF.
    A messages block becomes one slide per message (D42); track slides carry data-track="<step>-a|b" (D45). -#}
<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ L.title }} · מצגת</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;600;700;800&family=Secular+One&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../_assets/reveal/reset.css">
<link rel="stylesheet" href="../_assets/reveal/reveal.css">
<link rel="stylesheet" href="../_assets/slides.css">
</head>
<body>
{{ kit_defs }}
<div class="reveal"><div class="slides">
{% for s in slides %}
<section class="s-pic {{ s.cls }}" data-n="{{ s.n }}"{% if s.track %} data-track="{{ s.track }}"{% endif %}>
  <div class="frame">
    <div class="txt">
      {% if s.kicker %}<div class="kicker">{{ s.kicker }}</div>{% endif %}
      {% if s.h1 %}<h1>{{ s.title }}</h1>{% else %}<h2>{{ s.title }}</h2>{% endif %}
      {% if s.sub %}<p class="sub">{{ s.sub }}</p>{% endif %}
      {% if s.points %}<ol class="pts">{% for p in s.points %}<li class="fragment">{{ p }}</li>{% endfor %}</ol>{% endif %}
      {% if s.link %}<a class="go" href="{{ s.link }}" target="_blank" rel="noopener">לסרטון ←</a>{% endif %}
    </div>
    <div class="pic">{{ s.art }}</div>
    {% if s.timer %}<div class="foot"><span>{{ s.timer_label }}</span><span class="timer" data-sec="{{ s.timer }}"></span></div>{% endif %}
  </div>
</section>
{% endfor %}
</div></div>
<script src="../_assets/reveal/reveal.js"></script>
<script src="../_assets/lesson.js"></script>
<script src="../_assets/deck.js"></script>
</body>
</html>
